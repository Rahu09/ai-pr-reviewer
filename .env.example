# Copy to .env (git-ignored) and fill in values. NEVER commit .env.
# .env is read by Spring as a .properties file:
#   - paths use FORWARD slashes (E:/production/secrets/app-pkcs8.pem)
#   - no quotes around values

# LLM (ADR-0018): google-genai (default) or openai. Only the active provider's key is needed.
LLM_PROVIDER=google-genai
GEMINI_API_KEY=
OPENAI_API_KEY=

# GitHub access (Chunk 6-7): fine-grained PAT. Named GITHUB_PAT on purpose (gh/Actions read GITHUB_TOKEN).
GITHUB_PAT=

# GitHub App (Chunk 11)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Trusted PRs only (ADR-0019): comma-separated GitHub logins
REVIEWER_ALLOWED_AUTHORS=

# Jev / TypeSafe (Chunk 9)
TYPESAFE_API_KEY=

# Local Postgres (compose.yaml, host port 5433)
POSTGRES_PASSWORD=
